# OpenAI API atslēga — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Neobligāti — noklusējumi src/esupplier/config.py.
# Modelim jāatbalsta Responses API ar reasoning.effort.
# ESUPPLIER_MODEL=gpt-5.6-luna
# ESUPPLIER_EFFORT=medium
# ESUPPLIER_DB=data/catalog.db
# ESUPPLIER_ANSWERS=atbildes

# --- Pastkastīte (uv run mail) --------------------------------------------
# Aģents lasa vēstules pa IMAP un raksta atbildes ATPAKAĻ kā melnrakstus.
# SMTP nav: neviena vēstule klientam neaiziet bez cilvēka klikšķa.
# ESUPPLIER_IMAP_HOST=lima.trialine.lv
# ESUPPLIER_IMAP_USER=ai.0001@trialine.lv
# ESUPPLIER_IMAP_PASSWORD=...
# ESUPPLIER_IMAP_PORT=993
# ESUPPLIER_IMAP_SSL=1
# ESUPPLIER_IMAP_FOLDER=INBOX
# Tukšs = atrodam melnrakstu mapi pēc servera \Drafts karoga.
# ESUPPLIER_IMAP_DRAFTS=
# ESUPPLIER_MAIL_BATCH=10
# ESUPPLIER_MAIL_POLL=120
