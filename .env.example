# --- Dzinējs --------------------------------------------------------------
# Trīs ceļi pie modeļa, viena uzvedība. Izvēlies VIENU:
#
#   ESUPPLIER_ENGINE=anthropic   Claude API ar ANTHROPIC_API_KEY
#   ESUPPLIER_ENGINE=openai      ChatGPT (Responses API) ar OPENAI_API_KEY
#   ESUPPLIER_ENGINE=claude      Claude Agent SDK — maksā no abonementa,
#                                atslēga nav vajadzīga, bet vajag uzstādītu
#                                un pieteiktu Claude Code (noklusējums)
#
# `claude-api` un `chatgpt` arī der — tie ir tie paši `anthropic` un `openai`.
# Nezināma vērtība NEKRĪT klusi uz ChatGPT: programma pasaka, ka nesaprot.
# ESUPPLIER_ENGINE=anthropic

# Claude API atslēga — vajadzīga tikai ESUPPLIER_ENGINE=anthropic.
# https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...
# ESUPPLIER_CLAUDE_MODEL=claude-opus-5

# OpenAI API atslēga — vajadzīga tikai ESUPPLIER_ENGINE=openai.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Neobligāti — noklusējumi src/esupplier/config.py.
# Modelim jāatbalsta Responses API ar reasoning.effort.
# ESUPPLIER_MODEL=gpt-5.6-luna
# `anthropic` dzinējā tas pats mainīgais nosaka domāšanas budžetu:
# low=2000, medium=4000, high=8000 tokeni.
# ESUPPLIER_EFFORT=medium
# ESUPPLIER_DB=data/catalog.db
# ESUPPLIER_ANSWERS=atbildes

# --- Pastkastīte (uv run mail) --------------------------------------------
# Pārbaudi savienojumu ar `uv run mail --check` — tas modeli neizsauc.
#
# Gmail: parastu konta paroli IMAP pieslēgumiem Google nepieņem kopš 2022. gada.
# Vajag App Password, un to izdod tikai kontam ar divpakāpju verifikāciju.
# Gmail iestatījumos jābūt ieslēgtam IMAP; Workspace domēnā to var būt
# aizliedzis administrators.
#
# ESUPPLIER_IMAP_HOST=imap.gmail.com
# ESUPPLIER_IMAP_USER=vards@gmail.com
# ESUPPLIER_IMAP_PASSWORD=<16 zīmju App Password, bez atstarpēm>
# ESUPPLIER_IMAP_DRAFTS=          # tukšs der: Gmail atdod \Drafts karogu
# Aģents lasa vēstules pa IMAP un raksta atbildes ATPAKAĻ kā melnrakstus.
# SMTP nav: neviena vēstule klientam neaiziet bez cilvēka klikšķa.
# ESUPPLIER_IMAP_HOST=lima.trialine.lv
# ESUPPLIER_IMAP_USER=ai.0001@trialine.lv
# ESUPPLIER_IMAP_PASSWORD=...
# ESUPPLIER_IMAP_PORT=993
# ESUPPLIER_IMAP_SSL=1
# ESUPPLIER_IMAP_FOLDER=INBOX
# Tukšs = atrodam melnrakstu mapi pēc servera \Drafts karoga.
# ESUPPLIER_IMAP_DRAFTS=
# ESUPPLIER_MAIL_BATCH=10
# ESUPPLIER_MAIL_POLL=60

# --- Pielikumi ------------------------------------------------------------
# Aģents izvelk TEKSTU no PDF, Word (arī vecā .doc), Excel (arī .xls),
# PowerPoint, RTF, CSV, HTML un DXF rasējumiem. ZIP un 7z arhīvus izpako un
# lasa katru failu atsevišķi.
# ESUPPLIER_ATTACHMENT_MAX_BYTES=10000000
# ESUPPLIER_ATTACHMENT_CHARS=4000
# ESUPPLIER_ATTACHMENTS_CHARS=12000
# ESUPPLIER_ATTACHMENT_PDF_PAGES=20
# ESUPPLIER_ARCHIVE_MAX_FILES=12

# Vecais .doc un .ppt: tos izlasa tikai LibreOffice. Tukšs = meklējam `soffice`
# PATH. Ja tās uz mašīnas nav, tādi pielikumi paliek menedžerim.
# ESUPPLIER_SOFFICE=
# ESUPPLIER_SOFFICE_TIMEOUT=60

# --- Attēlu atšifrēšana ---------------------------------------------------
# Skenēts rasējums un telefona foto teksta slāni nesatur; tos izlasa modelis,
# kurš attēlu redz. Katrs tāds pielikums maksā vienu papildu izsaukumu.
# `0` izslēdz — tad tie atkal paliek menedžerim ar piezīmi "jāatver ar roku".
# ESUPPLIER_ATTACHMENT_VISION=1
# Tukšs = tas pats modelis, kas raksta vēstuli. Tam jāprot lasīt attēlus.
# ESUPPLIER_VISION_MODEL=
# ESUPPLIER_VISION_PAGES=5
# ESUPPLIER_VISION_DPI=150
# ESUPPLIER_VISION_CHARS=4000
# ESUPPLIER_VISION_MAX_FILES=5
# ESUPPLIER_VISION_MAX_BYTES=8000000
